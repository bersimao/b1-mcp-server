# ============================================================================
# sps-mcp-server — Environment Configuration
# ============================================================================

# --- Database Connection (OPTIONAL — legacy mode) ---
# If set, the server connects to this database at startup.
# For multi-database support, use ~/.claude/connections.json instead.
# MCP_DB_TYPE=hana              # hana or mssql
# MCP_DB_SERVER=your-server:30015    # Server hostname or IP
# MCP_DB_NAME=your-database           # Target database name
# MCP_DB_USR=your-user          # Database user
# MCP_DB_PWD=your-password      # Database password

# --- Connection Profiles ---
# Path to the connections.json file. Defaults to ~/.claude/connections.json.
# MCP_CONNECTIONS_FILE=~/.claude/connections.json
#
# Example profile in connections.json:
#   {
#     "id": "my_db",
#     "name": "My SAP DB",
#     "dbType": "hana",
#     "dbServer": "192.168.0.1:30015",
#     "dbName": "SBO_MY_DB",
#     "dbUser": "SYSTEM",
#     "dbPassword": "password",
#     "slUrl": "https://192.168.0.1:50000/b1s/v1",   (optional — Service Layer)
#     "slUser": "manager",                             (optional)
#     "slPassword": "password"                         (optional)
#   }

# --- Guardrails ---
MCP_MAX_QUERY_LENGTH=8000

# --- Audit Logging ---
# JSON Lines file. Set to empty to disable file logging (stderr always active).
MCP_AUDIT_LOG_PATH=./logs/audit.jsonl

# Logging level: debug | info | warn | error
MCP_LOG_LEVEL=info

# --- Procedure Inspection Cache ---
MCP_PROCEDURE_CACHE_TTL_MS=1800000    # 30 minutes
MCP_PROCEDURE_CACHE_MAX_SIZE=200

# --- Rate Limiting ---
MCP_RATE_LIMIT_MAX_CALLS=60           # Max calls per tool within the window
MCP_RATE_LIMIT_WINDOW_MS=60000        # Window size (60 seconds)

# --- Dry-Run Mode ---
# Set to "true" to validate queries without executing them.
# Useful for testing guardrails before connecting to a live database.
MCP_DRY_RUN=false
